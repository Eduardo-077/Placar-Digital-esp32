# Copie para ".env" (nesta mesma pasta) e troque os valores.
# O .env de verdade está no .gitignore e nunca deve ir para o GitHub.

# InfluxDB (senha com pelo menos 8 caracteres)
INFLUX_USUARIO=admin
INFLUX_SENHA=troque_esta_senha
# Token de administrador. Para gerar um:
#   Linux / Git Bash:  openssl rand -hex 32
#   PowerShell:        -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
INFLUX_TOKEN=troque_este_token

# Grafana
GRAFANA_USUARIO=admin
GRAFANA_SENHA=troque_esta_senha

# Supabase (o Node-RED lê os eventos daqui). Os mesmos valores do segredos.h
# do ESP: SUPABASE_URL e a chave anon/publishable (NUNCA a service_role/secret).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sua_chave_anon_aqui
